# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Email shown on /privacy for questions about personal data (optional; without it the page
# tells people to ask whoever invited them).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: override the site address used in share links. On Vercel the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=
